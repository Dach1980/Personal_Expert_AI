APP_ENV=development
APP_NAME=Personal Expert AI
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# LM Studio OpenAI-compatible local API
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=

# PostgreSQL
DATABASE_URL=postgresql+psycopg://personal_expert:change_me@localhost:5432/personal_expert
DATA_DIR=./data

# Private local document storage (keep outside version control)
# Optional override; defaults to the per-user local application data directory.
# DOCUMENT_STORAGE_ROOT=C:/Users/<user>/AppData/Local/PersonalExpertAI/documents
DOCUMENT_MAX_UPLOAD_BYTES=104857600

# Keycloak OIDC access-token validation (use the exact realm issuer URL)
OIDC_ISSUER=http://localhost:8080/realms/pea
OIDC_AUDIENCE=pea-api
# Use the realm JWKS endpoint; in containers this may be an internal URL while issuer remains public.
OIDC_JWKS_URL=http://localhost:8080/realms/pea/protocol/openid-connect/certs
