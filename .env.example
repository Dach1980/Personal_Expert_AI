APP_ENV=development
APP_NAME=Personal Expert AI
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# LM Studio OpenAI-compatible local API
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=

# PostgreSQL
DATABASE_URL=postgresql+psycopg://personal_expert:change_me@localhost:5432/personal_expert
DATA_DIR=./data

# Private local document storage (keep outside version control)
# Optional override; defaults to the per-user local application data directory.
# DOCUMENT_STORAGE_ROOT=C:/Users/<user>/AppData/Local/PersonalExpertAI/documents
DOCUMENT_MAX_UPLOAD_BYTES=104857600

# Keycloak OIDC access-token validation (use the exact realm issuer URL)
# Shared Keycloak realm created by the Bionic Stack OIDC component.
# Keep OIDC_ISSUER exactly equal to the token's iss claim.
OIDC_ISSUER=http://localhost:30000/oidc/realms/bionic-gpt
OIDC_AUDIENCE=pea-api
# For local PEA on the host: first run `kubectl -n keycloak port-forward svc/keycloak-service 8080:8080`.
OIDC_JWKS_URL=http://localhost:8080/realms/bionic-gpt/protocol/openid-connect/certs
