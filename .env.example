APP_ENV=development
APP_NAME=Personal Expert AI
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# LM Studio OpenAI-compatible local API
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=

# PostgreSQL
DATABASE_URL=postgresql+psycopg://personal_expert:change_me@localhost:5432/personal_expert
DATA_DIR=./data

# Private local document storage (keep outside version control)
DOCUMENT_STORAGE_ROOT=./var/documents
DOCUMENT_MAX_UPLOAD_BYTES=104857600

# JWT validation; tokens are issued by a trusted identity provider
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
